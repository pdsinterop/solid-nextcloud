{
    "name": "pdsinterop/solid-nextcloud",
    "description": "A WebID-OIDC Identity Provider, to allow interoperability with Solid Pods",
    "type": "project",
    "license": "MIT",
    "config": {
      "bin-dir": "bin",
      "preferred-install": "dist",
      "sort-packages": true,
      "vendor-dir": "vendor",
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "authors": [
        {
            "name": "Auke van Slooten"
        },
        {
            "name": "Yvo Brevoort"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "laminas/laminas-diactoros": "^3.8",
        "lcobucci/jwt": "^4.1",
        "pdsinterop/flysystem-nextcloud": "dev-feature/flysystem-3-adapter",
        "pdsinterop/flysystem-rdf": "^0.7",
        "pdsinterop/solid-auth": "dev-fix/flysystem-3-mpss",
        "pdsinterop/solid-crud": "dev-fix/flysystem-3-mpss",
        "phrity/websocket": "^3.5",
        "sweetrdf/easyrdf": ">=1.15.0 <1.16.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8 || ^9"
    }
}
